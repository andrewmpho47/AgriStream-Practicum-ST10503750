@model RealTimeProcessingSystem.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="surface account-panel">
    <p class="section-kicker">FARM ACCOUNT</p>
    <h1>Sign in</h1>
    <form asp-action="Login" method="post" class="farm-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"])" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="Username"></label>
        <input asp-for="Username" autocomplete="username" />
        <span asp-validation-for="Username" class="text-danger"></span>
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
        <button class="btn btn-primary" type="submit">Sign in</button>
    </form>
    <p class="mt-3"><a asp-action="Register">Create a farmer account</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
